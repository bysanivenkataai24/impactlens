# npm 10's resolver crashes ("Cannot read properties of null (reading 'edgesOut')")
# while walking vite 8's *optional* peer chain (@vitejs/devtools-vitest -> vitest@*).
# With legacy-peer-deps, optional peers are not auto-installed; every peer the
# project needs (vite, jsdom, @types/node, playwright via @playwright/test) is a
# direct devDependency instead. Applies to `npm ci` too, so installs reproduce.
legacy-peer-deps=true
save-exact=true
fund=false
audit=false
