# ImpactLens service configuration. Copy to .env for local runs:
#   cp .env.example .env && docker run --rm -p 7860:7860 --env-file .env impactlens
# On Hugging Face Spaces put SECRETS under Settings -> Secrets and the rest
# under Settings -> Variables. Never commit a filled-in .env.

# --- secrets (host secret store only) ------------------------------------
# Shared developer-pilot key, at least 24 random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Only needed to download a checkpoint from a private/gated Hub repository.
HF_TOKEN=

# --- model identity and source (set exactly one source) ------------------
# Human-readable id reported by /health and in every prediction.
MODEL_ID=
# Option A: a checkpoint file inside the container.
MODEL_PATH=
# Option B: a pinned file in a Hugging Face model repository.
MODEL_REPO=
MODEL_FILENAME=
# Full 40-character commit SHA of the model repository (not a branch or tag).
MODEL_REVISION=
# Strongly recommended: SHA-256 of the checkpoint (from models/<id>/SHA256SUMS).
MODEL_SHA256=

# --- runtime -------------------------------------------------------------
# cpu | cuda | cuda:<index> | mps. No silent fallback: an unavailable device makes /health not ready.
DEVICE=cpu
# Defaults to the image size the checkpoint was trained at.
INFERENCE_IMAGE_SIZE=
NMS_IOU=0.7
# Operating threshold chosen on the VALIDATION split (models/<id>/service.env).
DEFAULT_SCORE_THRESHOLD=0.25
MIN_SCORE_THRESHOLD=0.05
MAX_SCORE_THRESHOLD=0.95
MAX_DETECTIONS=50
MAX_POLYGON_POINTS=200

# --- request limits --------------------------------------------------------
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=50000000
MIN_IMAGE_SIDE=32
REQUEST_BODY_TIMEOUT_S=30
INFERENCE_TIMEOUT_S=60
# Requests allowed to wait while one inference runs; more get HTTP 429 server_busy.
MAX_PENDING_REQUESTS=4
# Per client address, per replica, in memory (not a distributed limiter).
RATE_LIMIT_PER_MINUTE=30
# Number of reverse proxies in front whose X-Forwarded-For you trust (0 = ignore the header).
TRUSTED_PROXY_HOPS=0

# --- web ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API from another site.
# Empty = same-origin only (the bundled UI needs nothing here). '*' is refused.
ALLOWED_ORIGINS=
# CSP frame-ancestors. Default 'none'; inside a Space (SPACE_ID set) 'self' https://huggingface.co.
FRAME_ANCESTORS=
# Public URL of this deployment's source code (AGPL-3.0 section 13), shown in the UI.
SOURCE_URL=
LOG_LEVEL=INFO
# background (default): serve the UI and /health at once, load the checkpoint after. blocking: load first.
MODEL_LOAD_MODE=background
HOST=0.0.0.0
PORT=7860
