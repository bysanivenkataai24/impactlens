{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "description": "[x_min, y_min, x_max, y_max], normalized to the EXIF-oriented image.",
          "items": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        },
        "damage_type": {
          "enum": [
            "dent",
            "scratch",
            "crack",
            "glass_shatter",
            "lamp_broken",
            "tire_flat"
          ],
          "title": "Damage Type",
          "type": "string"
        },
        "flags": {
          "items": {
            "enum": [
              "mask_fragmented",
              "polygon_simplified",
              "touches_image_border",
              "small_region"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "id": {
          "description": "Stable within one response, e.g. 'det-1'. Ordered by score.",
          "title": "Id",
          "type": "string"
        },
        "part": {
          "default": null,
          "description": "Always null in schema 1.x: the baseline has no validated part model.",
          "title": "Part",
          "type": "null"
        },
        "polygon": {
          "description": "Mask outline as [x, y] pairs, normalized like bbox.",
          "items": {
            "items": {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 2000,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "review_status": {
          "const": "pending_review",
          "default": "pending_review",
          "title": "Review Status",
          "type": "string"
        },
        "score": {
          "description": "Uncalibrated model score in [0, 1]. Not a probability of damage.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "severity": {
          "const": "unknown",
          "default": "unknown",
          "description": "Always 'unknown' in schema 1.x: the baseline has no validated severity model.",
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "id",
        "damage_type",
        "score",
        "bbox",
        "polygon"
      ],
      "title": "Detection",
      "type": "object"
    },
    "ImageInfo": {
      "additionalProperties": false,
      "properties": {
        "exif_orientation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "EXIF orientation tag found in the upload (1-8), or null if absent.",
          "title": "Exif Orientation"
        },
        "format": {
          "enum": [
            "JPEG",
            "PNG",
            "WEBP"
          ],
          "title": "Format",
          "type": "string"
        },
        "height": {
          "description": "Height in pixels after EXIF orientation is applied.",
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "orientation_applied": {
          "description": "True when the pixels were rotated/mirrored to honour the EXIF tag.",
          "title": "Orientation Applied",
          "type": "boolean"
        },
        "sha256": {
          "description": "SHA-256 of the uploaded bytes as received.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "width": {
          "description": "Width in pixels after EXIF orientation is applied.",
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "format",
        "exif_orientation",
        "orientation_applied",
        "sha256"
      ],
      "title": "ImageInfo",
      "type": "object"
    },
    "LatencyMs": {
      "additionalProperties": false,
      "properties": {
        "decode": {
          "minimum": 0,
          "title": "Decode",
          "type": "number"
        },
        "inference": {
          "description": "Model call, including pre/post-processing.",
          "minimum": 0,
          "title": "Inference",
          "type": "number"
        },
        "postprocess": {
          "minimum": 0,
          "title": "Postprocess",
          "type": "number"
        },
        "queue": {
          "description": "Time spent waiting for an inference slot.",
          "minimum": 0,
          "title": "Queue",
          "type": "number"
        },
        "total": {
          "description": "Server-side handling time for this request.",
          "minimum": 0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "queue",
        "decode",
        "inference",
        "postprocess",
        "total"
      ],
      "title": "LatencyMs",
      "type": "object"
    }
  },
  "$id": "impactlens/predict-response/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checkpoint Sha256",
      "type": "string"
    },
    "detections": {
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "title": "Detections",
      "type": "array"
    },
    "image": {
      "$ref": "#/$defs/ImageInfo"
    },
    "latency_ms": {
      "$ref": "#/$defs/LatencyMs"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "title": "Model Revision",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "detections_returned",
        "no_supported_region_returned"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score_threshold": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score Threshold",
      "type": "number"
    },
    "warnings": {
      "items": {
        "enum": [
          "detection_cap_reached",
          "invalid_detections_dropped"
        ],
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "model_id",
    "model_revision",
    "checkpoint_sha256",
    "image",
    "score_threshold",
    "outcome",
    "message",
    "detections",
    "latency_ms",
    "limitations"
  ],
  "title": "PredictResponse",
  "type": "object",
  "x-detection-flags": {
    "mask_fragmented": "The predicted mask had several disconnected pieces. Only the largest piece is returned as the polygon.",
    "polygon_simplified": "The mask outline had more vertices than the service limit and was simplified.",
    "small_region": "The region covers less than 0.1% of the photo. Small regions are typically the least reliable detections.",
    "touches_image_border": "The region reaches the edge of the photo, so the damage may continue outside the frame."
  }
}
