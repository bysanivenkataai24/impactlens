# Keep the build context small and free of secrets, data and local state.
.git
.gitignore
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.env
.env.*
!.env.example
datasets
data
runs
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/e2e/.fixtures
tests
docs
configs
*.log
